# Streamlit Community Cloud secrets template.
#
# On Streamlit Cloud: paste these into the app's Settings -> Secrets editor.
# Locally: copy this file to `.streamlit/secrets.toml` (gitignored) and fill in
# real values, or just export GOOGLE_API_KEY in your shell.

# The key the deployment runs on, so a visitor can try the app without signing
# up for their own. Optional: leave it unset and the sidebar asks each visitor
# for a key instead. GEMINI_API_KEY is accepted as an alias. A key typed into
# the sidebar always takes priority over this one.
GOOGLE_API_KEY = "your-google-api-key"

# Public demo only. Caps uploads so one visitor cannot exhaust the container's
# memory, and pins answers to the cheaper Flash Lite tier so a hosted key is
# not worth draining. Leave unset for a local run; demo mode is off by default.
DEMO_MODE = "true"
MAX_UPLOADS_PER_SESSION = "5"
