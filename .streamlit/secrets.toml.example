# Streamlit Community Cloud secrets template.
#
# On Streamlit Cloud: paste these into the app's Settings -> Secrets editor.
# Locally: copy this file to `.streamlit/secrets.toml` (gitignored) and fill in
# real values.

# Required: Gemini API key for embeddings + LLM.
GEMINI_API_KEY = "your-gemini-api-key"

# Public demo only. Caps uploads so one visitor cannot exhaust the container's
# memory, and pins answers to Flash so one visitor cannot exhaust the daily
# quota on gemini-2.5-pro. Leave unset for a local run; demo mode is off by
# default.
DEMO_MODE = "true"
MAX_UPLOADS_PER_SESSION = "5"
